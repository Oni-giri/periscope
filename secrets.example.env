# Copy to /data/secrets.env and chmod 600.
# Live scrape path uses OpenRouter + a signed-in Chrome profile.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: old list/fetch xclient path only
X_AUTH_TOKEN=
X_CT0=

# Unused on the live scrape Settings UI; kept for Umbrel/list mode
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
